# maki - isi "Edit config" (/etc/network/interfaces) di GNS3
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address 10.72.4.21
    netmask 255.255.255.0
    gateway 10.72.4.1
    up echo nameserver 192.168.122.1 > /etc/resolv.conf
    up test -f /root/startup.sh && bash /root/startup.sh || true
